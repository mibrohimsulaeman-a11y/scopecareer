{
  "registry_id": "REG-STATE-V1",
  "version": "1.0.0-draft",
  "state_machines": [
    {
      "id": "SM-CANDIDATE-DISPOSITION",
      "entity": "ENT-OPPORTUNITY",
      "dimension": "candidate_disposition",
      "states": [
        "discovered",
        "passed",
        "watching",
        "exploring",
        "pursuing",
        "closed"
      ],
      "transitions": [
        {
          "from": "discovered",
          "to": "passed",
          "action": "ACT-OPPORTUNITY-PASS"
        },
        {
          "from": "discovered",
          "to": "watching",
          "action": "ACT-OPPORTUNITY-WATCH"
        },
        {
          "from": "discovered",
          "to": "exploring",
          "action": "ACT-OPPORTUNITY-EXPLORE"
        },
        {
          "from": "passed",
          "to": "watching",
          "action": "ACT-OPPORTUNITY-WATCH"
        },
        {
          "from": "passed",
          "to": "exploring",
          "action": "ACT-OPPORTUNITY-EXPLORE"
        },
        {
          "from": "watching",
          "to": "exploring",
          "action": "ACT-OPPORTUNITY-EXPLORE"
        },
        {
          "from": "exploring",
          "to": "pursuing",
          "action": "ACT-OPPORTUNITY-PURSUE"
        },
        {
          "from": "pursuing",
          "to": "watching",
          "action": "ACT-OPPORTUNITY-WATCH"
        },
        {
          "from": "pursuing",
          "to": "closed",
          "action": "ACT-OPPORTUNITY-CLOSE"
        },
        {
          "from": "watching",
          "to": "closed",
          "action": "ACT-OPPORTUNITY-CLOSE"
        },
        {
          "from": "exploring",
          "to": "closed",
          "action": "ACT-OPPORTUNITY-CLOSE"
        },
        {
          "from": "passed",
          "to": "closed",
          "action": "ACT-OPPORTUNITY-CLOSE"
        }
      ],
      "orthogonal_to": [
        "SM-OPPORTUNITY-SEARCH",
        "SM-CANDIDATE-SELECTION",
        "SM-PRIORITY-ALLOCATION"
      ],
      "invariants": [
        "priority is not a disposition state",
        "pass is reversible through later watch/explore",
        "disposition is candidate-private"
      ]
    },
    {
      "id": "SM-PRIORITY-ALLOCATION",
      "entity": "ENT-OPPORTUNITY",
      "dimension": "priority_allocation",
      "states": [
        "inactive",
        "active"
      ],
      "transitions": [
        {
          "from": "inactive",
          "to": "active",
          "action": "ACT-PRIORITY-ACTIVATE",
          "guard": "candidate_disposition == pursuing AND priority_policy_allows"
        },
        {
          "from": "active",
          "to": "inactive",
          "action": "ACT-PRIORITY-DEACTIVATE"
        }
      ],
      "orthogonal_to": [
        "SM-CANDIDATE-DISPOSITION",
        "SM-OPPORTUNITY-SEARCH",
        "SM-CANDIDATE-SELECTION"
      ],
      "invariants": [
        "priority is internal attention allocation",
        "priority is not employer-visible",
        "max_active is policy-controlled"
      ]
    },
    {
      "id": "SM-OPPORTUNITY-SEARCH",
      "entity": "ENT-OPPORTUNITY",
      "dimension": "opportunity_search_state",
      "states": [
        "hypothesis",
        "open",
        "recruiting",
        "paused",
        "filled",
        "cancelled",
        "unknown"
      ],
      "transitions": [
        {
          "from": "hypothesis",
          "to": "open",
          "action": "ACT-SEARCH-STATE-UPDATE"
        },
        {
          "from": "unknown",
          "to": "open",
          "action": "ACT-SEARCH-STATE-UPDATE"
        },
        {
          "from": "open",
          "to": "recruiting",
          "action": "ACT-SEARCH-STATE-UPDATE"
        },
        {
          "from": "recruiting",
          "to": "paused",
          "action": "ACT-SEARCH-STATE-UPDATE"
        },
        {
          "from": "paused",
          "to": "recruiting",
          "action": "ACT-SEARCH-STATE-UPDATE"
        },
        {
          "from": "open",
          "to": "filled",
          "action": "ACT-SEARCH-STATE-UPDATE"
        },
        {
          "from": "recruiting",
          "to": "filled",
          "action": "ACT-SEARCH-STATE-UPDATE"
        },
        {
          "from": "open",
          "to": "cancelled",
          "action": "ACT-SEARCH-STATE-UPDATE"
        },
        {
          "from": "recruiting",
          "to": "cancelled",
          "action": "ACT-SEARCH-STATE-UPDATE"
        }
      ],
      "orthogonal_to": [
        "SM-CANDIDATE-DISPOSITION",
        "SM-CANDIDATE-SELECTION",
        "SM-PRIORITY-ALLOCATION"
      ],
      "invariants": [
        "search state requires source/assertion basis",
        "candidate disposition never mutates search state implicitly"
      ]
    },
    {
      "id": "SM-CANDIDATE-SELECTION",
      "entity": "ENT-OPPORTUNITY",
      "dimension": "candidate_selection_state",
      "states": [
        "not_started",
        "contacted",
