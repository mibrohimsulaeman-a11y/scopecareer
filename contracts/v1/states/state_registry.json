          "action": "ACT-SELECTION-STATE-UPDATE"
        },
        {
          "from": "interview",
          "to": "final",
          "action": "ACT-SELECTION-STATE-UPDATE"
        },
        {
          "from": "final",
          "to": "reference",
          "action": "ACT-SELECTION-STATE-UPDATE"
        },
        {
          "from": "reference",
          "to": "offer",
          "action": "ACT-SELECTION-STATE-UPDATE"
        },
        {
          "from": "offer",
          "to": "closed",
          "action": "ACT-SELECTION-STATE-UPDATE"
        },
        {
          "from": "contacted",
          "to": "closed",
          "action": "ACT-SELECTION-STATE-UPDATE"
        },
        {
          "from": "applied",
          "to": "closed",
          "action": "ACT-SELECTION-STATE-UPDATE"
        },
        {
          "from": "recruiter_screen",
          "to": "closed",
          "action": "ACT-SELECTION-STATE-UPDATE"
        },
        {
          "from": "interview",
          "to": "closed",
          "action": "ACT-SELECTION-STATE-UPDATE"
        },
        {
          "from": "final",
          "to": "closed",
          "action": "ACT-SELECTION-STATE-UPDATE"
        },
        {
          "from": "reference",
          "to": "closed",
          "action": "ACT-SELECTION-STATE-UPDATE"
        }
      ],
      "orthogonal_to": [
        "SM-CANDIDATE-DISPOSITION",
        "SM-OPPORTUNITY-SEARCH",
        "SM-PRIORITY-ALLOCATION"
      ],
      "invariants": [
        "selection state does not imply candidate pursuit recommendation",
        "external application submission requires separate external-effect receipt"
      ]
    },
    {
      "id": "SM-ASSERTION-EPISTEMIC",
      "entity": "ENT-ASSERTION",
      "dimension": "epistemic_status",
      "states": [
        "unknown",
        "needs_research",
        "inferred",
        "known"
      ],
      "transitions": [
        {
          "from": "unknown",
          "to": "needs_research",
          "action": "ACT-ASSERTION-MARK-RESEARCH"
        },
        {
          "from": "unknown",
          "to": "inferred",
          "action": "ACT-ASSERTION-COMMIT-INFERRED",
          "guard": "supporting_observation_or_source AND confidence_present"
        },
        {
          "from": "unknown",
          "to": "known",
          "action": "ACT-ASSERTION-COMMIT-KNOWN",
          "guard": "accepted_source_evidence"
        },
        {
          "from": "needs_research",
          "to": "inferred",
          "action": "ACT-ASSERTION-COMMIT-INFERRED",
          "guard": "supporting_observation_or_source AND confidence_present"
        },
        {
          "from": "needs_research",
          "to": "known",
          "action": "ACT-ASSERTION-COMMIT-KNOWN",
          "guard": "accepted_source_evidence"
        },
        {
          "from": "inferred",
          "to": "known",
          "action": "ACT-ASSERTION-COMMIT-KNOWN",
          "guard": "new_accepted_source_evidence"
        }
      ],
      "invariants": [
        "AI confidence alone cannot produce known",
        "history is preserved by supersession"
      ]
    },
    {
      "id": "SM-SHARE-PACKET",
      "entity": "ENT-SHARE-PACKET",
      "dimension": "share_packet_state",
      "states": [
        "draft",
        "approved",
        "shared",
        "expired",
        "revoked"
      ],
      "transitions": [
        {
          "from": "draft",
          "to": "approved",
          "action": "ACT-SHARE-PACKET-APPROVE"
        },
        {
          "from": "approved",
          "to": "shared",
          "action": "ACT-SHARE-PACKET-SEND"
        },
        {
          "from": "approved",
          "to": "revoked",
          "action": "ACT-SHARE-PACKET-REVOKE"
        },
        {
          "from": "shared",
          "to": "revoked",
          "action": "ACT-SHARE-PACKET-REVOKE"
        },
        {
          "from": "shared",
          "to": "expired",
          "action": "ACT-SHARE-PACKET-EXPIRE"
        }
      ],
      "invariants": [
        "approve is not share",
        "share is an external effect"
      ]
    },
    {
      "id": "SM-EXTERNAL-EFFECT",
      "entity": "ENT-EXTERNAL-EFFECT-REQUEST",
      "dimension": "external_effect_state",
      "states": [
        "draft",
        "awaiting_confirmation",
        "authorized",
        "executing",
        "succeeded",
        "failed",
        "outcome_unknown",
        "cancelled"
      ],
      "transitions": [
        {
          "from": "draft",
          "to": "awaiting_confirmation",
          "action": "ACT-EXTERNAL-EFFECT-REQUEST"
        },
        {
          "from": "awaiting_confirmation",
          "to": "authorized",
          "action": "ACT-EXTERNAL-EFFECT-CONFIRM"
        },
        {
          "from": "authorized",
          "to": "executing",
          "action": "ACT-EXTERNAL-EFFECT-EXECUTE"
        },
        {
          "from": "executing",
          "to": "succeeded",
          "action": "ACT-EXTERNAL-EFFECT-RECONCILE",
          "guard": "success_receipt"
        },
        {
          "from": "executing",
          "to": "failed",
          "action": "ACT-EXTERNAL-EFFECT-RECONCILE",
          "guard": "failure_receipt"
        },
        {
          "from": "executing",
          "to": "outcome_unknown",
          "action": "ACT-EXTERNAL-EFFECT-RECONCILE",
          "guard": "no_definitive_receipt"
        },
        {
          "from": "awaiting_confirmation",
          "to": "cancelled",
          "action": "ACT-EXTERNAL-EFFECT-CANCEL"
        }
      ],
      "invariants": [
        "succeeded requires receipt",
        "draft/internal preparation cannot transition directly to succeeded"
      ]
    },
    {
