        },
        {
          "from": "attested",
          "to": "superseded",
          "action": "ACT-CAREER-CLAIM-SUPERSEDE"
        }
      ],
      "invariants": [
        "attested is self-attestation, not external verification",
        "AI cannot attest for candidate"
      ]
    },
