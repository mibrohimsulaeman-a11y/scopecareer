        },
        {
          "from": "not_started",
          "to": "applied",
          "action": "ACT-SELECTION-STATE-UPDATE"
        },
        {
          "from": "contacted",
          "to": "recruiter_screen",
          "action": "ACT-SELECTION-STATE-UPDATE"
        },
        {
          "from": "applied",
          "to": "recruiter_screen",
          "action": "ACT-SELECTION-STATE-UPDATE"
        },
        {
          "from": "recruiter_screen",
