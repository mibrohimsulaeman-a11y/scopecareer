      "effect_class": "read",
      "output_contract": {
        "entities": [
          "ENT-CAREER-CLAIM",
          "ENT-CAREER-INTENT",
          "ENT-ASSERTION"
        ],
        "minimized": true
      },
      "canonical_actions": [],
      "input_schema_ref": "candidate_schema_registry.json#/tools/career.get_context/input_schema",
      "output_schema_ref": "candidate_schema_registry.json#/tools/career.get_context/output_schema"
    },
    {
      "name": "career.review_strategy",
      "effect_class": "read",
      "output_contract": {
        "requires": [
          "sample_size",
          "confidence",
          "context"
        ]
      },
      "canonical_actions": [],
      "input_schema_ref": "candidate_schema_registry.json#/tools/career.review_strategy/input_schema",
      "output_schema_ref": "candidate_schema_registry.json#/tools/career.review_strategy/output_schema"
    },
    {
