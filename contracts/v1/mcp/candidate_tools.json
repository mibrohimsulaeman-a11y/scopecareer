{
  "registry_id": "REG-MCP-CANDIDATE-V1",
  "version": "1.0.0-draft",
  "rules": [
    "domain tools over CRUD explosion",
    "every call is server-side reauthorized",
    "resource minimization by purpose",
    "prepare is not external effect",
    "disposition and selection state use separate tools"
