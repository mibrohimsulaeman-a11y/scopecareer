{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scopecareer.local/schemas/product-validation-1-session.json",
  "title": "ScopeCareer Product Validation-1 Session Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["session_id", "conducted_at", "participant_segment", "consent", "tasks", "hypotheses", "overall_notes"],
  "properties": {
    "session_id": {"type": "string", "pattern": "^PV1-P[0-9]{2,3}$"},
    "conducted_at": {"type": "string", "format": "date-time"},
    "participant_segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seniority", "function", "search_state", "recent_transition", "recruiter_or_search_firm_experience", "confidential_opportunity_experience", "international_search_experience"],
      "properties": {
        "seniority": {"type": "string"},
        "function": {"type": "string"},
        "search_state": {"type": "string"},
        "recent_transition": {"type": "boolean"},
        "recruiter_or_search_firm_experience": {"type": "boolean"},
        "confidential_opportunity_experience": {"type": "boolean"},
        "international_search_experience": {"type": "boolean"}
      }
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["research_participation", "recording"],
      "properties": {
        "research_participation": {"const": true},
        "recording": {"type": "boolean"}
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "completed", "observations"],
        "properties": {
          "task_id": {"type": "string", "enum": ["attention", "opportunity_compare", "opportunity_dossier", "explore_pursue", "pursuit_workspace", "access_plan", "evidence_binding", "stage_aware_workspace", "mobile_companion"]},
          "completed": {"type": "boolean"},
          "time_to_first_action_seconds": {"type": ["number", "null"], "minimum": 0},
          "observations": {"type": "array", "items": {"type": "string"}},
          "participant_quotes": {"type": "array", "items": {"type": "string"}},
          "confusions": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "hypotheses": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["hypothesis_id", "outcome", "evidence"],
        "properties": {
          "hypothesis_id": {"type": "string", "enum": ["PV-H01", "PV-H02", "PV-H03", "PV-H04", "PV-H05", "PV-H06", "PV-H07", "PV-H08"]},
          "outcome": {"type": "string", "enum": ["supported", "mixed", "contradicted", "not_tested"]},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "confidence": {"type": "string", "enum": ["low", "moderate", "high"]}
        }
      }
    },
    "terminology_confusion": {"type": "array", "items": {"type": "string"}},
    "trust_concerns": {"type": "array", "items": {"type": "string"}},
    "missing_information": {"type": "array", "items": {"type": "string"}},
    "requested_features": {"type": "array", "items": {"type": "string"}},
    "spontaneous_value_statements": {"type": "array", "items": {"type": "string"}},
    "overall_notes": {"type": "array", "items": {"type": "string"}}
  }
}
